# Copy to .env and replace placeholders with the intended Shopify environment.
# Actual credentials must be shared privately, never committed.
PUBLIC_STORE_DOMAIN=your-store.myshopify.com
PUBLIC_STOREFRONT_API_TOKEN=replace_with_storefront_public_token
PUBLIC_STOREFRONT_ID=replace_with_storefront_id
SESSION_SECRET=replace_with_a_new_random_secret
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=replace_with_customer_account_client_id
PUBLIC_CUSTOMER_ACCOUNT_API_URL=replace_with_customer_account_api_url
SHOP_ID=replace_with_shop_id

# Uncomment only when supplied/needed for your environment:
# PRIVATE_STOREFRONT_API_TOKEN=replace_with_private_storefront_token
# PUBLIC_CHECKOUT_DOMAIN=your-checkout-domain.example
